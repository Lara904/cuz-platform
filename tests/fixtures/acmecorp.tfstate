{
  "version": 4,
  "terraform_version": "1.7.0",
  "resources": [
    {
      "type": "kubernetes_deployment",
      "name": "frontend",
      "provider": "kubernetes",
      "instances": [
        {
          "attributes": {
            "namespace": "production"
          }
        }
      ]
    },
    {
      "type": "kubernetes_deployment",
      "name": "backend",
      "provider": "kubernetes",
      "instances": [
        {
          "attributes": {
            "namespace": "production"
          }
        }
      ]
    },
    {
      "type": "minio_bucket",
      "name": "acmecorp-archive",
      "provider": "minio",
      "instances": [
        {
          "attributes": {
            "bucket": "acmecorp-archive"
          }
        }
      ]
    }
  ]
}