{
  "version": 4,
  "terraform_version": "1.7.0",
  "resources": [
    {
      "type": "kubernetes_deployment",
      "name": "frontend",
      "provider": "kubernetes",
      "instances": [
        {
          "attributes": {
            "namespace": "production"
          }
        }
      ]
    },
    {
      "type": "kubernetes_deployment",
      "name": "backend",
      "provider": "kubernetes",
      "instances": [
        {
          "attributes": {
            "namespace": "production"
          }
        }
      ]
    },
    {
      "type": "minio_bucket",
      "name": "acmecorp-archive",
      "provider": "minio",
      "instances": [
        {
          "attributes": {
            "bucket": "acmecorp-archive"
          }
        }
      ]
    },
    {
      "type": "aws_iam_role",
      "name": "stale_admin_role",
      "provider": "aws",
      "instances": [
        {
          "attributes": {
            "name": "stale-admin-role",
            "last_used_date": "2026-05-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "type": "aws_security_group_rule",
      "name": "ssh_open_world",
      "provider": "aws",
      "instances": [
        {
          "attributes": {
            "from_port": 22,
            "to_port": 22,
            "protocol": "tcp",
            "cidr_blocks": [
              "0.0.0.0/0"
            ]
          }
        }
      ]
    },
    {
      "type": "aws_acm_certificate",
      "name": "expired_cert",
      "provider": "aws",
      "instances": [
        {
          "attributes": {
            "domain_name": "legacy.acmecorp.local",
            "not_after": "2026-01-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "type": "aws_iam_role",
      "name": "permanent_admin_role",
      "provider": "aws",
      "instances": [
        {
          "attributes": {
            "name": "permanent-admin-role",
            "is_admin": true,
            "permanent": true
          }
        }
      ]
    }
  ]
}